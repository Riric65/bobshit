# realistic programs
# --- fizzbuzz
for i in 1 to 30
  if i % 15 == 0 then say "FizzBuzz"
  elif i % 3 == 0 then say "Fizz"
  elif i % 5 == 0 then say "Buzz"
  else say i
  end
end

# --- filter / map helpers
fun filter_even xs
  out = []
  for x in xs
    if x % 2 == 0 then push(out, x) end
  end
  return out
end

fun double_all xs
  out = []
  for x in xs
    push(out, x * 2)
  end
  return out
end

nums = range(1, 10)
say filter_even(nums)
say double_all(nums)
say filter_even(double_all(range(1, 5)))

# --- reduce by hand
fun total xs
  acc = 0
  for x in xs
    acc = acc + x
  end
  return acc
end
say total([1, 2, 3, 4, 5])

# --- config map
cfg = {
  host: "bob.xem.yt",
  port: 443,
  soft: true,
  retries: 3
}
if cfg.soft then say "running soft on", cfg.host end
say "port", cfg.port, "retries", cfg.retries
for k, v in cfg
  say k, ":", v
end

# --- word count
text = "the quick brown fox jumps over the lazy dog the fox"
words = split(text, " ")
counts = {}
for w in words
  n = 0
  if has(counts, w) then n = counts[w] end
  counts[w] = n + 1
end
say keys(counts)
say counts.the, counts.fox, counts.dog

# --- primes with a sieve (lists are 0 indexed, sieve[i] is about i)
limit = 30
sieve = []
for i in 0 to limit
  push(sieve, true)
end
sieve[0] = false
sieve[1] = false
for i in 2 to limit
  if sieve[i]
    for j in i * 2 to limit step i
      sieve[j] = false
    end
  end
end
primes = []
for i in 2 to limit
  if sieve[i] then push(primes, i) end
end
say primes

# --- bubble sort (0 indexed)
fun bubble xs
  n = len(xs)
  for i in 0 to n - 2
    for j in 0 to n - 2 - i
      if xs[j] > xs[j + 1]
        tmp = xs[j]
        xs[j] = xs[j + 1]
        xs[j + 1] = tmp
      end
    end
  end
  return xs
end
say bubble([5, 2, 9, 1, 5, 6])

# --- binary search
fun bsearch xs target
  lo = 0
  hi = len(xs) - 1
  while lo <= hi
    mid = floor((lo + hi) / 2)
    if xs[mid] == target then return mid end
    if xs[mid] < target
      lo = mid + 1
    else
      hi = mid - 1
    end
  end
  return -1
end
sorted = [1, 3, 5, 7, 9, 11]
say bsearch(sorted, 7), bsearch(sorted, 4)

# --- string report
words2 = ["bobshit", "xem", "langage"]
say "--- rapport"
chars = 0
for i, w in words2
  say i, ":", w, "(", len(w), " caractères)"
  chars = chars + len(w)
end
say "total:", chars
